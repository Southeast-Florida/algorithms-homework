import numpy as np

def tridiagonalize_householder(A):
    """
    Приводит симметричную матрицу A к трёхдиагональному виду 
    методом отражений Хаусхолдера.
    
    Параметры:
    A : np.ndarray
        Входная симметричная матрица (n x n)
        
    Возвращает:
    T : np.ndarray
        Трёхдиагональная матрица
    Q : np.ndarray
        Матрица преобразования (ортогональная), такая что T = Q.T @ A @ Q
    """
    n = A.shape[0]
    if A.shape[0] != A.shape[1]:
        raise ValueError("Матрица должна быть квадратной")
    
    # Делаем копию, чтобы не портить исходную матрицу
    T = A.astype(float).copy()
    
    # Инициализируем матрицу преобразования как единичную
    Q = np.eye(n)
    
    # Основной цикл по k от 0 до n-3 (так как нам нужно обнулить элементы ниже первой побочной диагонали)
    # В терминах конспекта: "для каждого столбца (кроме последних двух)"
    for k in range(n - 2):
        # 1) Формируем вектор x из поддиагональных элементов k-го столбца
        # (индексы от k+1 до n-1)
        x = T[k+1:, k].copy()
        
        # Если все элементы уже нулевые, пропускаем шаг
        if np.allclose(x[1:], 0):
            continue
            
        # 2) Вычисляем знак и норму
        # Знак выбираем противоположным знаку первого элемента x, чтобы избежать 
        # вычитания близких чисел (потери точности)
        sign = 1.0 if x[0] >= 0 else -1.0
        norm_x = np.linalg.norm(x)
        
        # Вектор e1 (первый базисный вектор размерности x)
        e1 = np.zeros_like(x)
        e1[0] = 1.0
        
        # Вычисляем вектор v = x + sign * ||x|| * e1
        v = x + sign * norm_x * e1
        
        # 3) Нормируем вектор v, получаем единичный вектор u
        norm_v = np.linalg.norm(v)
        if norm_v < 1e-15:
            continue
        u = v / norm_v
        
        # 4) Строим матрицу отражения Хаусхолдера H' = E - 2*u*u^T
        # Размерность H' равна (n-k-1) x (n-k-1)
        H_prime = np.eye(len(x)) - 2.0 * np.outer(u, u)
        
        # 5) Встраиваем H' в полную матрицу H_k размера n x n
        # H_k = [[1, 0, ..., 0],
        #        [0,              ],
        #        [.,    H'        ],
        #        [0,              ]]
        H_k = np.eye(n)
        H_k[k+1:, k+1:] = H_prime
        
        # Применяем преобразование подобия: T = H_k * T * H_k
        # (так как H_k симметрична и ортогональна, H_k^T = H_k)
        T = H_k @ T @ H_k
        
        # Накапливаем матрицу преобразования Q = Q * H_k
        Q = Q @ H_k
        
    return T, Q

# --- Пример использования ---
if __name__ == "__main__":
    # Создадим случайную симметричную матрицу 5x5
    np.random.seed(42)
    A = np.random.rand(5, 5)
    A = (A + A.T) / 2  # Делаем её симметричной
    
    print("Исходная матрица A:")
    print(np.round(A, 4))
    print()
    
    T, Q = tridiagonalize_householder(A)
    
    print("Трёхдиагональная матрица T:")
    print(np.round(T, 4))
    print()
    
    # Проверка: T должна быть симметричной и трёхдиагональной
    # (все элементы ниже первой побочной диагонали должны быть ~0)
    print("Матрица преобразования Q (ортогональная):")
    print(np.round(Q, 4))
    print()
    
    # Проверка свойства: T = Q^T * A * Q
    T_check = Q.T @ A @ Q
    print("Проверка T == Q^T * A * Q:")
    print(np.allclose(T, T_check))
